# --- segredos: NUNCA versionar ---
.env
.env.*
*.pem

# --- dependências e lixo do sistema ---
node_modules/
.DS_Store
Thumbs.db
*.log

# --- material do evento que não é nosso (dados e kits da organização): fica só na máquina ---
# A base de dados do desafio e o brandbook/deck do workshop são da organização; o README explica onde colocá-los.
base-de-dados/
marketing/

# --- configuração local de ferramentas de IA e skills de terceiros instaladas ---
.claude/
.agents/
.frontend-slides/
skills-lock.json

# --- prints de apoio (já embutidos no deck, que vai no repositório) ---
pitch/assets/

# --- saídas geradas (rodadas do agente, página, baseline): derivam da base do evento e são regeneráveis ---
conferente/saida/*
# ...exceto a tela pronta: o pré-júri abre direto, sem rodar nada
!conferente/saida/index.html
